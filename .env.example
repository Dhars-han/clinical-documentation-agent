# DeepSeek API Configuration
# Get your API key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek Model selection (e.g., deepseek-chat, deepseek-reasoner)
# Default is deepseek-chat (DeepSeek-V3)
DEEPSEEK_MODEL=deepseek-chat

# DeepSeek API Base URL
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: Hosted Database for production (e.g. Neon, Supabase PostgreSQL)
# If omitted, automatically falls back to local SQLite clinical.db
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/clinical?sslmode=require
